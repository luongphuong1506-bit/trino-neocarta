# Cấu hình xuất metadata Trino -> file Cypher (neocarta).
# Copy file này thành prod.env, điền giá trị, rồi chạy:
#   .\.venv\Scripts\python.exe export_cypher.py --env-file prod.env
# Tham số dòng lệnh (--catalog, -o, ...) nếu truyền sẽ ghi đè giá trị trong file.
# KHÔNG commit file đã điền (prod.env đã nằm trong .gitignore).

# ---------------------------------------------------------------- Trino
TRINO_HOST=trino.example.com
TRINO_PORT=443
TRINO_HTTP_SCHEME=https
# true | false | đường dẫn tới file CA (.pem) nếu Trino dùng chứng chỉ nội bộ
TRINO_VERIFY=true
# Để trống khi dùng OAuth2: Trino lấy user từ token (điền user khác = impersonation)
TRINO_USER=

# ---------------------------------------------------------------- Xác thực
#   oauth2             : đăng nhập qua trình duyệt (Trino cấu hình authentication.type=oauth2)
#   client_credentials : service account, không cần đăng nhập tay (điền OAUTH2_* bên dưới)
#   jwt                : token có sẵn (TRINO_JWT_TOKEN)
#   none               : không xác thực (stack Docker test)
TRINO_AUTH=oauth2

# Chỉ dùng khi TRINO_AUTH=client_credentials
# Keycloak: https://<keycloak>/realms/<realm>/protocol/openid-connect/token
OAUTH2_TOKEN_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_SCOPE=

# Chỉ dùng khi TRINO_AUTH=jwt
TRINO_JWT_TOKEN=

# ---------------------------------------------------------------- Phạm vi quét
# Một hoặc nhiều catalog, cách nhau bởi dấu cách hoặc dấu phẩy
CATALOGS=postgres iceberg
# Để trống = tất cả schema (trừ information_schema). Dạng "schema" hoặc "catalog.schema"
SCHEMAS=
# Số giá trị mẫu mỗi cột (đọc dữ liệu thật). 0 = tắt
SAMPLE_VALUES=0
# Cột không bao giờ lấy giá trị mẫu (PII)
EXCLUDE_COLUMNS=email full_name phone

# ---------------------------------------------------------------- File xuất ra
OUTPUT=out/metadata.cypher
# community: constraint UNIQUE (chạy được trên cả community và enterprise)
# enterprise: constraint NODE KEY (chỉ enterprise)
NEO4J_EDITION=community
BATCH_SIZE=500
